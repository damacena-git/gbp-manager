{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "schedules": {
    "publish-posts": {
      "schedule": "*/15 * * * *",
      "timezone": "America/Sao_Paulo",
      "path": "/api/cron?task=publish_posts",
      "requestMethod": "GET"
    },
    "daily-all": {
      "schedule": "0 9 * * *",
      "timezone": "America/Sao_Paulo",
      "path": "/api/cron?task=all",
      "requestMethod": "GET"
    },
    "sync-metrics": {
      "schedule": "0 6 * * *",
      "timezone": "America/Sao_Paulo",
      "path": "/api/cron?task=sync_metrics",
      "requestMethod": "GET"
    }
  }
}
